{
  "name": "ksf-screen",
  "version": "0.5.0",
  "description": "KSF Screen - compartilhamento de tela entre amigos",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "build": "electron-builder --win nsis",
    "publish": "electron-builder --win nsis --publish always"
  },
  "keywords": [],
  "author": "Kaue",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "node-gyp": "^13.0.2"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "node-addon-api": "^8.9.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "build": {
    "appId": "com.ksf.screen",
    "productName": "KSF Screen",
    "asar": true,
    "files": [
      "index.html",
      "index.js",
      "package.json",
      "node_modules/**/*",
      "native-audio/build/Release/ksf_audio.node"
    ],
    "asarUnpack": [
      "native-audio/build/Release/ksf_audio.node"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KSF Screen",
      "artifactName": "KSF-Screen-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "DELEIZADA",
        "repo": "KSF-Screen"
      }
    ]
  }
}